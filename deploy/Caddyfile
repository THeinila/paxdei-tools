# Public hostname for the service. Use a real subdomain (recommended) whose DNS
# A record points at this VM's public IP — e.g. paxdei.erech.fi. Caddy obtains
# and auto-renews a Let's Encrypt cert for it via the HTTP-01 challenge, so ports
# 80 and 443 must be reachable and DNS must already resolve to the VM (see
# DEPLOY.md). For a quick test before you have a domain, a sslip.io/nip.io name
# embedding the IP also works (e.g. 129-151-221-127.sslip.io).
paxdei.erech.fi {
	# Compress responses. The app bundle inlines the whole item dataset, so it is
	# ~1.8 MB raw and ~180 KB gzipped — a 10x saving on the single largest thing
	# this host serves, which matters a lot on 1/8 of an OCPU. Caddy skips
	# already-compressed types (webp icons, images) automatically.
	encode zstd gzip

	header {
		# HSTS only. Caddy redirects http->https but does not send this by
		# default. Everything else (CSP, nosniff, Referrer-Policy, X-Frame-Options)
		# is set by the app in server/securityHeaders.ts, so the policy lives next
		# to the code that would break it — setting them here too would just send
		# every header twice.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	reverse_proxy 127.0.0.1:8787
}
